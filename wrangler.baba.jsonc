{
  // 馬場（クッション値・含水率・コース情報）だけを JRA から取る Worker。
  // 本体 jra-dify-pipeline から Service Binding の fetch() で呼ぶ。公開 URL は持たない。
  //
  // placement は fetch ハンドラにだけ効く。RPC には効かない。
  // scheduled と queue（Dify）は本体に残し、この Worker には置かない。
  //
  // region は「そのクラウドリージョンに最も近い Cloudflare 拠点」で fetch を動かす指定。
  // aws:ap-northeast-1 は東京。Worker 自体は AWS の中では動かない。
  // Smart Placement（mode=smart）は遅延の最適化で、日本に固定できない。
  // 一度も動いていない拠点は候補に入らない。jra.go.jp は Akamai（anycast）なので
  // placement.hostname / host でも拠点は特定できない。
  "name": "jra-baba-fetcher",
  "main": "src/babaFetcher.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "placement": {
    "region": "aws:ap-northeast-1"
  },
  "observability": {
    "enabled": true,
    "issues": {
      "enabled": true
    }
  }
}
