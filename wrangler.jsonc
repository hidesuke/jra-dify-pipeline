{
  "name": "jra-dify-pipeline",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Workers Logs（ダッシュボード Observability）。Free でも利用可
  // issues = 問題検出（例外・5xx・console.error をグルーピング。ベータ中は無料）
  "observability": {
    "enabled": true,
    "issues": {
      "enabled": true
    }
  },
  "vars": {
    // 検証済み Destination（ダッシュボードと同期。再デプロイで消えないように wrangler にも書く）
    "NOTIFY_EMAIL": "hidesuke@gmail.com",
    // Email Routing ドメイン上の From
    "NOTIFY_FROM": "noreply@koumeinowana.info",
    // 失敗メールに載せる /seed の origin
    "PUBLIC_BASE_URL": "https://jra-dify-pipeline.hdsk.workers.dev"
  },
  // チェックサム seed と 1R 失敗セッション。binding 名は Worker の env.CHECKSUM_SEED と一致させる
  "kv_namespaces": [
    {
      "binding": "CHECKSUM_SEED",
      "id": "ad0ce28a8f2b444c9a4b45643bb2cd9e"
    }
  ],
  "send_email": [
    {
      // 検証済み Destination address 宛てに送信（自分宛通知）
      "name": "EMAIL",
      // ローカル wrangler dev でも本番 Email Service に接続する
      "remote": true
    }
  ],
  // 金・土 16:45 JST（UTC 7:45）に翌日分を投入する。
  // Cloudflare の曜日は 1=日 … 7=土。数字の 5/6 は木/金になるので FRI/SAT を使う。
  "triggers": {
    "crons": [
      "45 7 * * FRI", // 金曜 16:45 JST
      "45 7 * * SAT"  // 土曜 16:45 JST
    ]
  },
  "queues": {
    "producers": [
      { "binding": "RACE_QUEUE", "queue": "jra-race-queue" }
    ],
    "consumers": [
      {
        "queue": "jra-race-queue",
        "max_batch_size": 1,        // 1メッセージずつ処理
        "max_batch_timeout": 5,
        "max_retries": 3,           // 失敗時は3回まで自動リトライ
        "max_concurrency": 2        // 同時実行数（Difyの許容負荷に合わせて1〜3程度）
      }
    ]
  }
}