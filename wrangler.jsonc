{
  "name": "jra-dify-pipeline",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // main の Workers Builds では、この command が本体のアップロード前に jra-baba-fetcher を出す。
  // main 以外とローカルの dev では何もしない。PR は未作成の Service Binding で失敗してよい。
  "build": {
    "command": "node scripts/ensure-baba-fetcher.mjs"
  },
  // Workers Logs（ダッシュボード Observability）。Free でも利用可
  // issues = 問題検出（例外・5xx・console.error をグルーピング。ベータ中は無料）
  "observability": {
    "enabled": true,
    "issues": {
      "enabled": true
    }
  },
  "vars": {
    // 検証済み Destination（ダッシュボードと同期。再デプロイで消えないように wrangler にも書く）
    "NOTIFY_EMAIL": "hidesuke@gmail.com",
    // Email Routing ドメイン上の From
    "NOTIFY_FROM": "noreply@koumeinowana.info",
    // 失敗メールに載せる /seed の origin
    "PUBLIC_BASE_URL": "https://jra-dify-pipeline.hdsk.workers.dev"
  },
  // チェックサム seed と 1R 失敗セッション。binding 名は Worker の env.CHECKSUM_SEED と一致させる
  "kv_namespaces": [
    {
      "binding": "CHECKSUM_SEED",
      "id": "ad0ce28a8f2b444c9a4b45643bb2cd9e"
    }
  ],
  "send_email": [
    {
      // 検証済み Destination address 宛てに送信（自分宛通知）
      "name": "EMAIL",
      // ローカル wrangler dev でも本番 Email Service に接続する
      "remote": true
    }
  ],
  // 金・土 16:45 JST（UTC 7:45）に翌日分を投入する。
  // Cloudflare の曜日は 1=日 … 7=土。数字の 5/6 は木/金になるので FRI/SAT を使う。
  "triggers": {
    "crons": [
      "45 7 * * FRI", // 金曜 16:45 JST
      "45 7 * * SAT"  // 土曜 16:45 JST
    ]
  },
  // 馬場取得だけ別 Worker。placement は Worker の fetch ハンドラ全体に効くため、
  // Dify の queue や 1R 検証を東京へ寄せない。RPC は placement が効かないので fetch() で呼ぶ。
  // 先に jra-baba-fetcher が無いと、この binding 付きのアップロードは失敗する。
  // main のビルドでは上の build.command が先に出す。PR のビルドは出さない。
  "services": [
    { "binding": "BABA_FETCHER", "service": "jra-baba-fetcher" }
  ],
  "queues": {
    "producers": [
      { "binding": "RACE_QUEUE", "queue": "jra-race-queue" }
    ],
    "consumers": [
      {
        "queue": "jra-race-queue",
        // 同時実行数 N の上限。src/concurrency.ts の DIFY_CONCURRENCY_MAX と揃える。
        // 実際の N は KV（未設定なら 3）。この値を超える N はエンドポイントが拒否する。
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,           // 失敗時は3回まで自動リトライ（延期の再投入では消費しない）
        // バッチは同時に 1 本だけ。N 並列はバッチの中で行うので、デプロイなしで N を変えられる。
        "max_concurrency": 1
      }
    ]
  }
}